{
  // ==========================================
  // 通用编辑器与代码风格（对齐 .editorconfig）
  // ==========================================
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // ==========================================
  // 文件关联（解决 Helm 模板与 YAML 语法冲突）
  // ==========================================
  "files.associations": {
    "**/apps/**/templates/**/*.yaml": "helm-template",
    "**/apps/**/templates/**/*.tpl": "helm-template",
    "**/helm/**/templates/**/*.yaml": "helm-template",
    "**/helm/**/templates/**/*.tpl": "helm-template",
    "justfile": "just",
    ".shellcheckrc": "ini"
  },

  // ==========================================
  // 文件过滤与搜索排除
  // ==========================================
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.rumdl_cache": true
  },
  "search.exclude": {
    "**/.rumdl_cache": true
  },

  // ==========================================
  // YAML 与 Kubernetes 校验配置
  // ==========================================
  "yaml.validate": true,
  "yaml.format.enable": true,
  "yaml.schemas": {
    "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": [
      "docker-compose.yml",
      "docker-compose.*.yml",
      "docker/**/docker-compose.yml",
      "docker/**/docker-compose.*.yml"
    ],
    "https://json.schemastore.org/github-workflow.json": [
      ".github/workflows/*.yml",
      ".github/workflows/*.yaml"
    ],
    "kubernetes": [
      "argocd/**/*.yaml",
      "argocd/**/*.yml"
    ]
  },

  // ==========================================
  // Shell 脚本开发体验（ShellCheck + shfmt）
  // ==========================================
  "shellcheck.enable": true,
  "shellcheck.run": "onType",
  "shellcheck.ignorePatterns": {
    "**/.shellcheckrc": true
  },
  "shfmt.flagConfig": [
    "-bn",
    "-ci",
    "-sr"
  ],

  // ==========================================
  // Dockerfile 静态分析
  // ==========================================
  "hadolint.cliPath": "hadolint",

  // ==========================================
  // 语言特定格式化与缩进规则
  // ==========================================
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[helm-template]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "[dockerfile]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
