# ==============================================================================
# Git 忽略规则 (.gitignore) - k3s-infra 生产云原生基础设施
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 密钥、私钥与临时解密文件 (0 凭据入库防护)
# ------------------------------------------------------------------------------
# 私钥与证书文件
*.key
*.priv
*.age
*.pem
*.crt
# 白名单放行 Sealed Secrets 离线公钥证书
!platform/security/sealed-secrets/public-cert.pem

# 密钥文本与凭据导出
*keys.txt
*.keys.json
.sealed-secrets-master.key
iam/open-bao/.keys.json
iam/open-bao/.approle-credentials.txt
**/pgbouncer/userlist.txt
**/mosquitto/config/passwd

# 临时明文与解密中间文件
*.dec.yaml
*.dec.yml
*.plain.yaml
*.plain.yml
*.unenc.yaml
*.unenc.yml
*.tmp.yaml
*.tmp.yml
*.secret.local.yaml
*.secret.local.yml

# ------------------------------------------------------------------------------
# 2. 环境变量与本地配置 (.env)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
/.env
/logs/
/data/
/backup/

# 证书工具与域名配置
cloudflare.ini
aliyun.ini
registry.ini
scripts/registry.ini
certbot/conf/renewal/
certbot/conf/aliyun.ini
certbot/conf/cloudflare.ini
ssh/

# ------------------------------------------------------------------------------
# 3. 操作系统与 IDE / 终端工具
# ------------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db

# IDE 与编辑器
.idea/
.zed/
.vscode/
*.swp
*.swo
*~
.codebuddy
.qoder
.kiro

# AI Agent 临时与缓存目录
.claude/
.agents/skills/
.agent/

# ------------------------------------------------------------------------------
# 4. 依赖包与本地状态缓存
# ------------------------------------------------------------------------------
**/node_modules/
**/homepage/logs/
iam/authelia/db.sqlite3
iam/authelia/config/db.sqlite3
devtools/argocd/kube/config
**/3xui/db/**
**/sui/db/**
**/sui/cert/**
