# k3s-infra 全集群机密配置模版 (.secrets.env.example)
# 用法: cp .secrets.env.example .secrets.env -> 填写真实凭证 -> just bao-sync

# 1. 边缘网关 (Traefik)
[traefik/cloudflare-api-token]
# Cloudflare DNS-01 证书申请 Token
token=your-cloudflare-dns-api-token

# 2. 对象存储 (Garage S3)
[storage/garage-config]
# 单行内联配置文件 (含 \n 转义)
garage.toml="metadata_dir = \"/var/lib/garage/meta\"\ndata_dir = \"/var/lib/garage/data\"\nreplication_factor = 1\n"

[storage/garage-secrets]
# 节点 RPC 通信密钥 (32 字节十六进制)
rpcSecret=generate-32-byte-hex-rpc-secret
# 管理员 API Token
admin-token=generate-secure-garage-admin-token
# 预置默认全局 S3 访问凭据
default-access-key=GK_DEFAULT_ACCESS_KEY_EXAMPLE
default-secret-key=generate-secure-garage-secret-key

[storage/rclone-backup-secret]
# Rclone 冷备配置
rclone.conf="[garage]\ntype = s3\nprovider = Other\nendpoint = http://garage.storage.svc:3900\n"

# 3. 数据库与缓存 (PostgreSQL & Valkey)
[database/postgres-app-credentials]
# 业务主库账户与密码
username=bgin_user
password=generate-strong-db-password

[database/garage-s3-credentials]
# Barman 物理全备专用 S3 凭据
ACCESS_KEY_ID=GK_CNPG_BACKUP_ACCESS_KEY
SECRET_ACCESS_KEY=generate-cnpg-backup-secret-key

[messaging/valkey-secret]
# 缓存访问密码
password=generate-strong-valkey-password

# 4. 安全防护与认证 (Authelia & CrowdSec)
[security/authelia-secret]
# Authelia JWT / Session / 存储加密密钥
JWT_SECRET=generate-random-jwt-secret-string
SESSION_SECRET=generate-random-session-secret-string
STORAGE_ENCRYPTION_KEY=generate-random-32-char-encryption-key

[security/crowdsec-secrets]
# CrowdSec Traefik Bouncer API Key
traefik-bouncer-key=generate-crowdsec-bouncer-api-key

# 5. 消息队列与推送 (Centrifugo & Mosquitto)
[messaging/centrifugo-secrets]
# Centrifugo 管理员凭据 / API Key / HMAC 密钥
admin-password=generate-centrifugo-admin-password
admin-secret=generate-centrifugo-admin-secret
api-key=generate-centrifugo-api-key
token-hmac-secret-key=generate-centrifugo-hmac-secret-key

[messaging/mosquitto-auth]
# MQTT 认证 (username:password)
passwd=mqttuser:generate-mqtt-password

# 6. 全文搜索与图片处理 (Meilisearch & Imgproxy)
[search/meilisearch-master-key]
# Meilisearch Master Key (至少 16 字符)
MEILI_MASTER_KEY=generate-meilisearch-master-key-min-16-bytes

[media/imgproxy-secrets]
# 签名 Key 与 Salt (十六进制)
key=generate-hex-encoded-imgproxy-key
salt=generate-hex-encoded-imgproxy-salt

# 7. 可观测性 (Beszel, OpenObserve, Portainer)
[observability/beszel-agent-secret]
# 监控公钥与 Agent Token
key=your-beszel-public-key
token=generate-beszel-agent-token

[observability/openobserve-secrets]
# 管理员账户与 S3 存储凭据
auth-token=generate-openobserve-auth-token
root-email=admin@example.com
root-password=generate-openobserve-root-password
s3-access-key=GK_OPENOBSERVE_ACCESS_KEY
s3-secret-key=generate-openobserve-s3-secret-key

[observability/portainer-admin-password]
# 初始化 admin 密码 (至少 12 位)
password=generate-strong-portainer-admin-password

# 8. 业务后端服务 (bgin)
[apps/bgin-secret]
# 对象存储访问
AWS_ACCESS_KEY_ID=GK_BGIN_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=generate-bgin-s3-secret-key
# 实时推送
CENTRIFUGO_API_KEY=generate-centrifugo-api-key
CENTRIFUGO_SECRET=generate-centrifugo-secret
# PostgreSQL 连接串
DB_URL=postgres://bgin_user:password@postgres-cluster-rw.database.svc:5432/bgin?sslmode=disable
# 图片动态处理
IMGPROXY_KEY=generate-hex-encoded-imgproxy-key
IMGPROXY_SALT=generate-hex-encoded-imgproxy-salt
# 用户 JWT 鉴权
JWT_SECRET=generate-bgin-jwt-secret
# 全文搜索
MEILISEARCH_KEY=generate-meilisearch-search-key
# Valkey 缓存与队列
REDIS_URL=redis://:password@valkey-primary.database.svc:6379/0
# 邮件服务 API Key
RESEND_API_KEY=re_generate_resend_api_key
# 默认初始管理员密码
SEED_ADMIN_PASSWORD=generate-initial-admin-password
